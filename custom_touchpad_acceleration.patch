diff --git a/build.sh b/build.sh
new file mode 100755
index 00000000..33f47fdc
--- /dev/null
+++ b/build.sh
@@ -0,0 +1,149 @@
+#!/bin/bash
+
+# Exit the script immediately if any command fails
+set -e
+
+BUILD_DIR="builddir"
+TARGET_DIR="/usr/lib64"
+TARGET_FILE="$TARGET_DIR/libinput.so.10.13.0"
+SOURCE_C="src/filter-touchpad.c"
+
+# 🔍 Step 0a: Verify Linux Distribution
+IS_FEDORA=false
+if [ -f /etc/os-release ]; then
+    if grep -q '^ID=fedora' /etc/os-release; then
+        IS_FEDORA=true
+    fi
+fi
+
+if [ "$IS_FEDORA" = false ]; then
+    echo "⚠️  WARNING: This script is explicitly tailored for Fedora GNOME!"
+    echo "It looks like you are running a different Linux distribution."
+    echo ""
+    echo "To adapt this script to your environment, you generally must change:"
+    echo "  1. The Package Manager: Swap 'dnf install' for your system tool (e.g., 'apt', 'pacman')."
+    echo "  2. Target Directory: Change TARGET_DIR. Ubuntu/Debian uses '/usr/lib/x86_64-linux-gnu', Arch uses '/usr/lib'."
+    echo "  3. Target Filename: Change TARGET_FILE to match your system's exact native libinput shared object filename version."
+    echo "  4. Security Labels: Non-SELinux distributions (like Ubuntu/Arch) do not use 'restorecon'. You can remove that step."
+    echo ""
+    read -p "Do you want to attempt running the script anyway? (y/N): " choice
+    if [[ ! "$choice" =~ ^[Yy]$ ]]; then
+        echo "❌ Build aborted."
+        exit 1
+    fi
+fi
+
+# 📦 Step 0b: First-Time Build Setup (Dependencies & Meson Init)
+if [ ! -d "$BUILD_DIR" ] || [ ! -f "$BUILD_DIR/build.ninja" ]; then
+    echo "🚀 First-time environment setup detected!"
+
+    if [ "$IS_FEDORA" = true ]; then
+        echo "📥 Installing compilation dependencies via DNF..."
+        sudo dnf install -y meson ninja-build cmake gcc gcc-c++ libudev-devel libevdev-devel libwacom-devel glib2-devel mtdev-devel
+    else
+        echo "⚠️  Please ensure you have manually installed meson, ninja, cmake, gcc, and development headers for udev/evdev before proceeding."
+    fi
+
+    echo "⚙️  Initializing the Meson build environment..."
+    meson setup "$BUILD_DIR" --prefix=/usr -Ddebug-gui=false
+fi
+
+# 🎛️ Step 0c: Interactive Acceleration Configuration
+CONFIG_TXT="/tmp/libinput_accel_config.txt"
+
+if [ ! -f "$SOURCE_C" ]; then
+    echo "❌ Error: $SOURCE_C not found! Make sure you run this script from the root of your libinput directory."
+    exit 1
+fi
+
+# Read current values out of the code file to pre-populate the editor session
+CURR_SENS=$(grep '#define INTER_SENSITIVITY' "$SOURCE_C" | awk '{print $3}' || echo "1.0")
+CURR_ACCEL=$(grep '#define INTER_ACCELERATION' "$SOURCE_C" | awk '{print $3}' || echo "0.0062")
+CURR_CAP=$(grep '#define INTER_SPEED_CAP' "$SOURCE_C" | awk '{print $3}' || echo "0.0")
+CURR_OFF=$(grep '#define INTER_OFFSET' "$SOURCE_C" | awk '{print $3}' || echo "0.0")
+CURR_POW=$(grep '#define INTER_POWER' "$SOURCE_C" | awk '{print $3}' || echo "2.0")
+
+cat << EOF > "$CONFIG_TXT"
+# Modify the values below. Save and close the editor to compile your driver automatically.
+# Note: Do not add spaces around the '=' sign.
+
+SENSITIVITY=$CURR_SENS
+ACCELERATION=$CURR_ACCEL
+SPEED_CAP=$CURR_CAP
+OFFSET=$CURR_OFF
+POWER=$CURR_POW
+EOF
+
+# Launch system editor (defaults to nano if $EDITOR isn't declared)
+echo "📝 Opening acceleration configuration manager..."
+${EDITOR:-nano} "$CONFIG_TXT"
+
+# Extract the newly updated values from the file
+NEW_SENS=$(grep '^SENSITIVITY=' "$CONFIG_TXT" | cut -d= -f2 | tr -d '[:space:]')
+NEW_ACCEL=$(grep '^ACCELERATION=' "$CONFIG_TXT" | cut -d= -f2 | tr -d '[:space:]')
+NEW_CAP=$(grep '^SPEED_CAP=' "$CONFIG_TXT" | cut -d= -f2 | tr -d '[:space:]')
+NEW_OFF=$(grep '^OFFSET=' "$CONFIG_TXT" | cut -d= -f2 | tr -d '[:space:]')
+NEW_POW=$(grep '^POWER=' "$CONFIG_TXT" | cut -d= -f2 | tr -d '[:space:]')
+
+# Validation check to prevent compilation failures from empty configurations
+if [ -z "$NEW_SENS" ] || [ -z "$NEW_ACCEL" ] || [ -z "$NEW_CAP" ] || [ -z "$NEW_OFF" ] || [ -z "$NEW_POW" ]; then
+    echo "❌ Error: One or more tracking metrics were left entirely blank. Build aborted."
+    exit 1
+fi
+
+echo "💾 Injecting new parameters directly into $SOURCE_C..."
+sed -i -E "s/(#define INTER_SENSITIVITY[[:space:]]+)[0-9.]+/\1$NEW_SENS/" "$SOURCE_C"
+sed -i -E "s/(#define INTER_ACCELERATION[[:space:]]+)[0-9.]+/\1$NEW_ACCEL/" "$SOURCE_C"
+sed -i -E "s/(#define INTER_SPEED_CAP[[:space:]]+)[0-9.]+/\1$NEW_CAP/" "$SOURCE_C"
+sed -i -E "s/(#define INTER_OFFSET[[:space:]]+)[0-9.]+/\1$NEW_OFF/" "$SOURCE_C"
+sed -i -E "s/(#define INTER_POWER[[:space:]]+)[0-9.]+/\1$NEW_POW/" "$SOURCE_C"
+
+echo "⚙️  Parameters successfully updated:"
+echo "   • Sensitivity:  $NEW_SENS"
+echo "   • Acceleration: $NEW_ACCEL"
+echo "   • Speed Cap:    $NEW_CAP"
+echo "   • Offset:       $NEW_OFF"
+echo "   • Power:        $NEW_POW"
+echo ""
+
+# 🔨 Step 1: Compiling the patched libinput source code...
+echo "🔨 Step 1: Compiling the patched libinput source code..."
+ninja -C "$BUILD_DIR"
+
+# ⚠️ Interactive Deployment Gate (Warning before session crash)
+echo ""
+echo "⚠️  CRITICAL WARNING: Overwriting the live system library file will likely"
+echo "crash your active GNOME display server and instantly log you out of your session."
+read -p "Do you want to proceed with deploying the changes right now? (y/N): " run_deploy
+
+if [[ ! "$run_deploy" =~ ^[Yy]$ ]]; then
+    echo "✅ Success! The updated library compiled perfectly inside: $BUILD_DIR"
+    echo "Deployment skipped. To apply it later without a sudden crash, copy it manually from a virtual terminal (TTY) or restart."
+    exit 0
+fi
+
+# 🎛️ Step 2: Switching GNOME touchpad profile to 'flat'...
+echo "🎛️ Step 2: Switching GNOME touchpad profile to 'flat'..."
+gsettings set org.gnome.desktop.peripherals.touchpad accel-profile 'flat'
+sleep 0.5
+
+# 🚀 Step 3: Overwriting the system library file
+echo "🚀 Step 3: Overwriting the system library file..."
+if [ -f "$BUILD_DIR/src/libinput.so.10.13.0" ]; then
+    SOURCE_FILE="$BUILD_DIR/src/libinput.so.10.13.0"
+else
+    SOURCE_FILE="$BUILD_DIR/libinput.so.10.13.0"
+fi
+
+sudo cp "$SOURCE_FILE" "$TARGET_FILE"
+
+# 🛡️ Step 4: Applying SELinux labels...
+echo "🛡️ Step 4: Applying SELinux labels..."
+if command -v restorecon &> /dev/null; then
+    sudo restorecon -v "$TARGET_FILE"
+fi
+
+# 🎛️ Step 5: Switching GNOME touchpad profile back to 'adaptive'...
+echo "🎛️ Step 5: Switching GNOME touchpad profile back to 'adaptive'..."
+gsettings set org.gnome.desktop.peripherals.touchpad accel-profile 'adaptive'
+
+echo "🚀 Flushing shared library buffers..."
+sudo ldconfig
+echo "✅ Success! Your updated mouse acceleration configuration is live."
diff --git a/src/filter-touchpad.c b/src/filter-touchpad.c
